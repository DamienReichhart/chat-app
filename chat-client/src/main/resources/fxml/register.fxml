<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.Circle?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.2"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ap4.client.controllers.RegisterController"
            style="-fx-background-color: #ffffff;">


    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">

            <Circle fx:id="logoCircle"
                    radius="50"
                    fill="#0088cc"
                    styleClass="login-logo" />

            <Label text="Telegram"
                   style="-fx-text-fill: #0088cc;
                          -fx-font-size: 32;
                          -fx-font-weight: BOLD;
                          -fx-padding: 0 0 20 0;" />
                          
            <Label text="Sign up for Telegram"
                   style="-fx-text-fill: #333333;
                          -fx-font-size: 18;" />

            <!-- Username Field -->
            <VBox spacing="5" alignment="CENTER">
                <Label text="Username"
                       style="-fx-text-fill: #707579;
                              -fx-font-size: 14;" />
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           styleClass="telegram-text-field"
                           prefWidth="280"
                           prefHeight="40" />
            </VBox>

            <!-- Email Field -->
            <VBox spacing="5" alignment="CENTER">
                <Label text="Email"
                       style="-fx-text-fill: #707579;
                              -fx-font-size: 14;" />
                <TextField fx:id="emailField"
                           promptText="Enter your email"
                           styleClass="telegram-text-field"
                           prefWidth="280"
                           prefHeight="40" />
            </VBox>

            <!-- Password Field -->
            <VBox spacing="5" alignment="CENTER">
                <Label text="Password"
                       style="-fx-text-fill: #707579;
                              -fx-font-size: 14;" />
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="telegram-text-field"
                               prefWidth="280"
                               prefHeight="40" />
            </VBox>

            <!-- Password Confirmation Field -->
            <VBox spacing="5" alignment="CENTER">
                <Label text="Confirm Password"
                       style="-fx-text-fill: #707579;
                              -fx-font-size: 14;" />
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Confirm your password"
                               styleClass="telegram-text-field"
                               prefWidth="280"
                               prefHeight="40" />
            </VBox>

            <!-- Register Button -->
            <Button fx:id="registerButton"
                    text="SIGN UP"
                    styleClass="telegram-primary-button"
                    prefWidth="280"
                    prefHeight="40"
                    onAction="#handleRegisterButton" />
                    
            <HBox alignment="CENTER" spacing="5" style="-fx-padding: 15 0 0 0;">
                <Label text="Already have an account?" style="-fx-text-fill: #707579;" />
                <Button fx:id="loginButton"
                        text="Sign In"
                        style="-fx-background-color: transparent; 
                               -fx-text-fill: #0088cc;
                               -fx-font-weight: BOLD;
                               -fx-underline: false;
                               -fx-cursor: hand;"
                        onAction="#handleLoginButton" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
