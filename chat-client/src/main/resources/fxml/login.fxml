<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.2"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ap4.client.controllers.LoginController"
            style="-fx-background-color: #ffffff;">
    
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">

            <Circle fx:id="logoCircle"
                    radius="50"
                    fill="#0088cc"
                    styleClass="login-logo" />

            <Label text="Telegram"
                   style="-fx-text-fill: #0088cc;
                          -fx-font-size: 32;
                          -fx-font-weight: BOLD;
                          -fx-padding: 0 0 20 0;" />
                          
            <Label text="Sign in to Telegram"
                   style="-fx-text-fill: #333333;
                          -fx-font-size: 18;" />

            <VBox spacing="5" alignment="CENTER">
                <Label text="Phone Number or Username"
                       style="-fx-text-fill: #707579;
                              -fx-font-size: 14;" />
                <TextField fx:id="usernameField"
                           promptText="Phone or Username"
                           styleClass="telegram-text-field"
                           prefWidth="280"
                           prefHeight="40" />
            </VBox>

            <VBox spacing="5" alignment="CENTER">
                <Label text="Password"
                       style="-fx-text-fill: #707579;
                              -fx-font-size: 14;" />
                <PasswordField fx:id="passwordField"
                               promptText="Password"
                               styleClass="telegram-text-field"
                               prefWidth="280"
                               prefHeight="40" />
            </VBox>

            <Button fx:id="loginButton"
                    text="NEXT"
                    styleClass="telegram-primary-button"
                    prefWidth="280"
                    prefHeight="40"
                    onAction="#handleLoginButton" />
                    
            <HBox alignment="CENTER" spacing="5" style="-fx-padding: 15 0 0 0;">
                <Label text="Don't have an account?" style="-fx-text-fill: #707579;" />
                <Button fx:id="registerButton"
                        text="Sign Up"
                        style="-fx-background-color: transparent; 
                               -fx-text-fill: #0088cc;
                               -fx-font-weight: BOLD;
                               -fx-underline: false;
                               -fx-cursor: hand;"
                        onAction="#handleRegisterButton" />
            </HBox>
        </VBox>
    </center>
</BorderPane>