<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.CheckBox?>

<BorderPane styleClass="chat-content" xmlns="http://javafx.com/javafx/21.0.2"
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.ap4.client.controllers.ChatContentController">

    <top>
        <VBox>
            <!-- Search Bar -->
            <HBox fx:id="searchBarContainer" spacing="5" styleClass="search-bar-container" visible="false" managed="false" translateY="-50">
                <TextField fx:id="searchField" promptText="Search in conversation..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button fx:id="closeSearchButton" text="✕" styleClass="close-search-button" onAction="#handleCloseSearchButton"/>
            </HBox>
            
            <!-- Pinned Messages Banner -->
            <HBox fx:id="pinnedMessagesBanner" spacing="10" styleClass="pinned-messages-banner" 
                  style="-fx-background-color: #f5f5f5; -fx-padding: 5; -fx-alignment: center-left; -fx-border-width: 0 0 1 0; -fx-border-color: #e0e0e0;"
                  visible="false" managed="false">
                <SVGPath fx:id="pinIcon" content="M16 5v9h-5v10l-7-12h5V2h7z" style="-fx-fill: #777;"/>
                <Label fx:id="pinnedMessagesLabel" text="Pinned Messages" styleClass="pinned-messages-label"/>
                <HBox HBox.hgrow="ALWAYS" style="-fx-pref-width: 9999;"/> <!-- Spacer -->
                <Button fx:id="closePinnedButton" text="✕" styleClass="close-pinned-button" 
                       style="-fx-background-color: transparent; -fx-padding: 0 5;" onAction="#handleClosePinnedButton"/>
            </HBox>
            
            <!-- Pinned Messages Panel -->
            <VBox fx:id="pinnedMessagesPanel" spacing="5" styleClass="pinned-messages-panel" 
                  style="-fx-background-color: white; -fx-padding: 10; -fx-border-width: 0 0 1 0; -fx-border-color: #e0e0e0; -fx-max-height: 200;"
                  visible="false" managed="false">
                <ListView fx:id="pinnedMessagesListView" id="pinnedMessagesListView" styleClass="pinned-messages-list" style="-fx-pref-height: 180;"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <ListView fx:id="messageListView" 
                  styleClass="message-list" />
    </center>

    <bottom>
        <HBox styleClass="input-area" spacing="10" alignment="CENTER_LEFT">
            <!-- Attachment button -->
            <Button fx:id="attachFileButton" styleClass="icon-button" onAction="#handleAttachFileButton">
                <graphic>
                    <SVGPath content="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"
                              style="-fx-fill: #8e8e93;" />
                </graphic>
                <tooltip>
                    <Tooltip text="Attach File" />
                </tooltip>
            </Button>
            
            <!-- Anonymous checkbox -->
            <CheckBox fx:id="anonymousCheckbox" text="Anonymous" styleClass="anonymous-checkbox" visible="false">
                <tooltip>
                    <Tooltip text="Send message anonymously (only in channels)" />
                </tooltip>
            </CheckBox>
            
            <!-- Message input field -->
            <TextField fx:id="messageField" 
                      styleClass="input-field"
                      promptText="Message" 
                      HBox.hgrow="ALWAYS"
                      onAction="#handleMessageField" />
            
            <!-- Send button -->
            <Button fx:id="sendButton" styleClass="send-button" onAction="#handleSendButton">
                <graphic>
                    <SVGPath content="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                              fill="white" />
                </graphic>
                <tooltip>
                    <Tooltip text="Send Message" />
                </tooltip>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
