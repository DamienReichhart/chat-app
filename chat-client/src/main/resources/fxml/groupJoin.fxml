<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox styleClass="dialog-container" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ap4.client.controllers.GroupJoinController"
      spacing="15">
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   
   <Text styleClass="dialog-title" text="Rejoindre un groupe" />
   
   <HBox alignment="CENTER" spacing="10.0" styleClass="search-box">
      <TextField fx:id="searchField" prefHeight="30.0" prefWidth="400.0" 
                promptText="Rechercher par nom ou description" 
                styleClass="dialog-input" />
      <Button fx:id="searchButton" mnemonicParsing="false" prefHeight="30.0" 
             styleClass="dialog-button" text="Rechercher" onAction="#handleSearchButton" />
   </HBox>
   
   <Text styleClass="dialog-subtitle" text="Groupes disponibles" />
   
   <ListView fx:id="groupListView" styleClass="dialog-list-view" VBox.vgrow="ALWAYS" />
   
   <Text fx:id="statusText" styleClass="status-text" textAlignment="CENTER" />
   
   <Button fx:id="joinButton" mnemonicParsing="false" 
          styleClass="dialog-button, primary-button" 
          text="Rejoindre le groupe sélectionné" onAction="#handleJoinButton" />

</VBox>
